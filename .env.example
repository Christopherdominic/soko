# Copy to .env and fill in. Never commit .env.
# Placeholders only — no real secrets belong in this file.

# --- Backend ---
SOKO_BIND_ADDR=127.0.0.1:4000
DATABASE_URL=postgres://soko:change-me@127.0.0.1:5436/soko
RUST_LOG=soko_backend=info,tower_http=info

# Origin of the frontend, used for CORS.
SOKO_FRONTEND_ORIGIN=http://localhost:3000

# --- Postgres (docker compose) ---
POSTGRES_USER=soko
POSTGRES_PASSWORD=change-me
POSTGRES_DB=soko

# --- LND (merchant's own node; Polar regtest in development) ---
# REST endpoint of the LND node. Use "localhost" (it is in LND's TLS cert).
LND_REST_URL=https://localhost:8082
# Path to LND's tls.cert. Soko pins this exact certificate.
LND_TLS_CERT_PATH=/path/to/lnd/tls.cert
# Path to a least-privilege macaroon (invoice.macaroon, or a baked one with
# invoices:read invoices:write). Never use admin.macaroon.
LND_MACAROON_PATH=/path/to/lnd/invoice.macaroon

# Default invoice expiry in seconds (60–86400).
SOKO_INVOICE_EXPIRY_SECS=900

# --- Merchant accounts ---
# Turn off after creating the merchant account so strangers can't sign up.
SOKO_ALLOW_REGISTRATION=true
# Set true when served over HTTPS (adds the Secure flag to the session cookie).
SOKO_COOKIE_SECURE=false
SOKO_SESSION_TTL_HOURS=168

# Hex 32-byte secret for deriving merchant Nostr receipt-signing keys.
# Generate with: openssl rand -hex 32. Keep it secret and stable: changing it changes
# every merchant's public key. Leave empty to disable signed receipts.
SOKO_NOSTR_SECRET=
